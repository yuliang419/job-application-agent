# Copy to .env and fill in real values. Never commit .env.

# API key for the configured LLM provider (OpenAI, Azure-compatible proxy, local server, etc.)
LLM_API_KEY=sk-your-api-key-here

# Model name passed to the chat completions endpoint
LLM_MODEL=gpt-4o-mini

# Override only for non-OpenAI/self-hosted OpenAI-compatible endpoints (e.g. http://localhost:11434/v1)
LLM_BASE_URL=

# Run scrapers without a visible browser window
HEADLESS_BROWSER=true

# Where reports, checkpoints, and generated cover letters are stored
JOB_AGENT_DATA_DIR=data
